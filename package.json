{
  "name": "bible-compass",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/content-contract.mjs",
    "verify": "node scripts/verify.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.1",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
